---
import { Star } from "@lucide/astro";

interface Props {
  postId: string;
}

const { postId } = Astro.props;
---

<button
  type="button"
  data-favorite-button
  data-post-id={postId}
  aria-label="Añadir a favoritos"
  aria-pressed="false"
  class="flex size-10 shrink-0 items-center justify-center rounded-md border border-border bg-black text-subtle transition-colors hover:bg-surface-soft hover:text-foreground"
>
  <Star data-favorite-icon class="size-[17px]" stroke-width={1.75} />
</button>

<script>
  import { favoritesChangedEvent } from "@/config/client";
  import { getFavorites, toggleFavorite } from "@/utils/favorites";

  (() => {
    const updateButton = (button, favorites) => {
      const postId = button.dataset.postId;

      if (!postId) {
        return;
      }

      const active = favorites.includes(postId);

      button.dataset.favorite = active ? "true" : "false";

      button.setAttribute("aria-pressed", active ? "true" : "false");

      button.setAttribute(
        "aria-label",
        active ? "Quitar de favoritos" : "Añadir a favoritos",
      );
    };

    const buttons = Array.from(
      document.querySelectorAll("[data-favorite-button]"),
    );

    let favorites = getFavorites();

    buttons.forEach((button) => {
      updateButton(button, favorites);

      button.addEventListener("click", () => {
        const postId = button.dataset.postId;

        if (!postId) {
          return;
        }

        favorites = toggleFavorite(postId);

        buttons.forEach((item) => {
          updateButton(item, favorites);
        });
      });
    });

    window.addEventListener(favoritesChangedEvent, (event) => {
      favorites = event.detail?.favorites ?? getFavorites();

      buttons.forEach((button) => {
        updateButton(button, favorites);
      });
    });
  })();
</script>
