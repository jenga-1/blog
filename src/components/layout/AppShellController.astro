<script is:inline>
  (() => {
    const STORAGE_KEY = "aprendo-sidebar-collapsed";

    const root = document.documentElement;

    const sidebar = document.querySelector("[data-sidebar]");

    const overlay = document.querySelector("[data-sidebar-overlay]");

    const mobileOpen = document.querySelector("[data-mobile-sidebar-open]");

    const mobileClose = document.querySelector("[data-mobile-sidebar-close]");

    const desktopToggle = document.querySelector(
      "[data-desktop-sidebar-toggle]",
    );

    const collapseIcon = document.querySelector("[data-collapse-icon]");

    const setSidebarGroupExpanded = (group, expanded) => {
      const toggle = group.querySelector("[data-sidebar-group-toggle]");

      const children = group.nextElementSibling;

      const chevron = group.querySelector("[data-sidebar-group-chevron]");

      if (!toggle || !children || !chevron) {
        return;
      }

      toggle.setAttribute("aria-expanded", String(expanded));

      toggle.setAttribute(
        "aria-label",
        `${expanded ? "Contraer" : "Expandir"} ${
          toggle.dataset.sidebarGroupLabel ?? "categoría"
        }`,
      );

      children.hidden = !expanded;

      chevron.classList.toggle("rotate-180", expanded);
    };

    const searchDialog = document.querySelector("[data-search-dialog]");

    const searchPanel = document.querySelector("[data-search-panel]");

    const searchInput = document.querySelector("[data-search-input]");

    const searchTriggers = document.querySelectorAll("[data-search-trigger]");

    const searchClose = document.querySelector("[data-search-close]");

    const searchEmpty = document.querySelector("[data-search-empty]");

    const searchNoResults = document.querySelector("[data-search-no-results]");

    const searchResultsWrapper = document.querySelector(
      "[data-search-results-wrapper]",
    );

    const searchResults = document.querySelector("[data-search-results]");

    const searchResultsCount = document.querySelector(
      "[data-search-results-count]",
    );

    let collapsed = false;
    let activeSearchIndex = 0;
    let currentResults = [];

    const searchItems = window.__APRendoSearchItems ?? [];

    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;

    const normalizeText = (value) =>
      value
        .toLocaleLowerCase("es")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    const escapeHtml = (value) =>
      value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

    const applySidebarState = () => {
      if (!sidebar) {
        return;
      }

      if (isDesktop()) {
        sidebar.classList.remove("-translate-x-full");

        if (collapsed) {
          sidebar.style.width = "72px";

          root.style.setProperty("--sidebar-offset", "72px");

          document
            .querySelectorAll(
              "[data-sidebar-label], [data-sidebar-section-label], [data-sidebar-item-label], [data-sidebar-item-chevron], [data-sidebar-children], [data-sidebar-profile-copy], [data-sidebar-profile-icon]",
            )
            .forEach((element) => {
              element.classList.add("hidden");
            });

          document
            .querySelectorAll("[data-sidebar-group]")
            .forEach((element) => {
              setSidebarGroupExpanded(element, false);
            });

          collapseIcon?.classList.add("rotate-180");
        } else {
          sidebar.style.width = "272px";

          root.style.setProperty("--sidebar-offset", "272px");

          document
            .querySelectorAll(
              "[data-sidebar-label], [data-sidebar-section-label], [data-sidebar-item-label], [data-sidebar-item-chevron], [data-sidebar-children], [data-sidebar-profile-copy], [data-sidebar-profile-icon]",
            )
            .forEach((element) => {
              element.classList.remove("hidden");
            });

          collapseIcon?.classList.remove("rotate-180");
        }

        return;
      }

      sidebar.style.width = "272px";

      root.style.setProperty("--sidebar-offset", "0px");

      document
        .querySelectorAll(
          "[data-sidebar-label], [data-sidebar-section-label], [data-sidebar-item-label], [data-sidebar-item-chevron], [data-sidebar-children], [data-sidebar-profile-copy], [data-sidebar-profile-icon]",
        )
        .forEach((element) => {
          element.classList.remove("hidden");
        });
    };

    const openMobileSidebar = () => {
      if (!sidebar || !overlay) {
        return;
      }

      sidebar.classList.remove("-translate-x-full");

      overlay.classList.remove("pointer-events-none", "opacity-0");

      overlay.classList.add("pointer-events-auto", "opacity-100");

      document.body.style.overflow = "hidden";
    };

    const closeMobileSidebar = () => {
      if (!sidebar || !overlay || isDesktop()) {
        return;
      }

      sidebar.classList.add("-translate-x-full");

      overlay.classList.add("pointer-events-none", "opacity-0");

      overlay.classList.remove("pointer-events-auto", "opacity-100");

      document.body.style.overflow = "";
    };

    const scoreItem = (item, query) => {
      const normalizedQuery = normalizeText(query);

      const title = normalizeText(item.title);

      const description = normalizeText(item.description);

      const category = normalizeText(item.categoryLabel);

      const tags = item.tags.map(normalizeText);

      let score = 0;

      if (title === normalizedQuery) {
        score += 100;
      }

      if (title.startsWith(normalizedQuery)) {
        score += 60;
      }

      if (title.includes(normalizedQuery)) {
        score += 40;
      }

      if (category === normalizedQuery) {
        score += 35;
      }

      if (category.includes(normalizedQuery)) {
        score += 20;
      }

      for (const tag of tags) {
        if (tag === normalizedQuery) {
          score += 30;
        } else if (tag.includes(normalizedQuery)) {
          score += 15;
        }
      }

      if (description.includes(normalizedQuery)) {
        score += 10;
      }

      const words = normalizedQuery.split(/\s+/).filter(Boolean);

      for (const word of words) {
        if (title.includes(word)) {
          score += 10;
        }

        if (category.includes(word)) {
          score += 5;
        }

        if (tags.some((tag) => tag.includes(word))) {
          score += 5;
        }
      }

      return score;
    };

    const updateSearchSelection = () => {
      const resultElements =
        searchResults?.querySelectorAll("[data-search-result]") ?? [];

      resultElements.forEach((element, index) => {
        const active = index === activeSearchIndex;

        element.dataset.active = active ? "true" : "false";

        if (active) {
          element.scrollIntoView({
            block: "nearest",
          });
        }
      });
    };

    const navigateToSelectedResult = () => {
      const selected = currentResults[activeSearchIndex];

      if (!selected) {
        return;
      }

      window.location.href = selected.href;
    };

    const renderResults = (query) => {
      if (
        !searchResults ||
        !searchEmpty ||
        !searchNoResults ||
        !searchResultsWrapper
      ) {
        return;
      }

      const trimmedQuery = query.trim();

      if (!trimmedQuery) {
        currentResults = [];
        activeSearchIndex = 0;

        searchEmpty.classList.remove("hidden");
        searchNoResults.classList.add("hidden");
        searchResultsWrapper.classList.add("hidden");

        searchResults.innerHTML = "";

        return;
      }

      currentResults = searchItems
        .map((item) => ({
          ...item,
          score: scoreItem(item, trimmedQuery),
        }))
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 8);

      activeSearchIndex = 0;

      searchEmpty.classList.add("hidden");

      if (currentResults.length === 0) {
        searchNoResults.classList.remove("hidden");

        searchResultsWrapper.classList.add("hidden");

        searchResults.innerHTML = "";

        return;
      }

      searchNoResults.classList.add("hidden");

      searchResultsWrapper.classList.remove("hidden");

      if (searchResultsCount) {
        searchResultsCount.textContent =
          currentResults.length === 1
            ? "1 resultado"
            : `${currentResults.length} resultados`;
      }

      searchResults.innerHTML = currentResults
        .map(
          (item, index) => `
              <a
                href="${escapeHtml(item.href)}"
                data-search-result
                data-active="${index === 0 ? "true" : "false"}"
                class="group flex items-start gap-3 rounded-lg px-3 py-3 transition-colors"
              >
                <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-[#262626] bg-black">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-[#737373]"
                    aria-hidden="true"
                  >
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                    <polyline points="14 2 14 8 20 8"/>
                  </svg>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="truncate text-[13px] font-medium text-[#ededed]">
                      ${escapeHtml(item.title)}
                    </span>
                  </div>

                  <p class="mt-0.5 line-clamp-1 text-[12px] text-[#737373]">
                    ${escapeHtml(item.description)}
                  </p>

                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    <span class="text-[11px] text-[#3291ff]">
                      ${escapeHtml(item.categoryLabel)}
                    </span>

                    ${item.tags
                      .slice(0, 3)
                      .map(
                        (tag) => `
                          <span class="text-[11px] text-[#525252]">
                            · ${escapeHtml(tag)}
                          </span>
                        `,
                      )
                      .join("")}
                  </div>
                </div>

                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="mt-1 shrink-0 text-[#525252]"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            `,
        )
        .join("");
    };

    const openSearch = () => {
      if (!searchDialog) {
        return;
      }

      searchDialog.classList.remove(
        "hidden",
        "pointer-events-none",
        "opacity-0",
      );

      searchDialog.classList.add("flex", "pointer-events-auto", "opacity-100");

      document.body.style.overflow = "hidden";

      window.requestAnimationFrame(() => {
        searchInput?.focus();
      });
    };

    const closeSearch = () => {
      if (!searchDialog) {
        return;
      }

      searchDialog.classList.add("hidden", "pointer-events-none", "opacity-0");

      searchDialog.classList.remove(
        "flex",
        "pointer-events-auto",
        "opacity-100",
      );

      document.body.style.overflow = "";

      if (searchInput) {
        searchInput.value = "";
      }

      renderResults("");
    };

    collapsed = localStorage.getItem(STORAGE_KEY) === "true";

    applySidebarState();

    desktopToggle?.addEventListener("click", () => {
      collapsed = !collapsed;

      localStorage.setItem(STORAGE_KEY, String(collapsed));

      applySidebarState();
    });

    document.querySelectorAll("[data-sidebar-group-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const group = toggle.closest("[data-sidebar-group]");

        if (!group) {
          return;
        }

        const expanded = toggle.getAttribute("aria-expanded") === "true";

        setSidebarGroupExpanded(group, !expanded);
      });
    });

    mobileOpen?.addEventListener("click", openMobileSidebar);

    mobileClose?.addEventListener("click", closeMobileSidebar);

    overlay?.addEventListener("click", closeMobileSidebar);

    searchTriggers.forEach((trigger) => {
      trigger.addEventListener("click", openSearch);
    });

    searchClose?.addEventListener("click", closeSearch);

    searchInput?.addEventListener("input", () => {
      renderResults(searchInput.value);
    });

    searchDialog?.addEventListener("click", (event) => {
      if (event.target === searchDialog) {
        closeSearch();
      }
    });

    searchPanel?.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    document.addEventListener("keydown", (event) => {
      const commandOrControl = event.metaKey || event.ctrlKey;

      if (commandOrControl && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openSearch();
        return;
      }

      const searchIsOpen = searchDialog?.classList.contains("flex");

      if (searchIsOpen && event.key === "ArrowDown") {
        event.preventDefault();

        if (currentResults.length > 0) {
          activeSearchIndex = (activeSearchIndex + 1) % currentResults.length;

          updateSearchSelection();
        }

        return;
      }

      if (searchIsOpen && event.key === "ArrowUp") {
        event.preventDefault();

        if (currentResults.length > 0) {
          activeSearchIndex =
            (activeSearchIndex - 1 + currentResults.length) %
            currentResults.length;

          updateSearchSelection();
        }

        return;
      }

      if (searchIsOpen && event.key === "Enter") {
        event.preventDefault();

        navigateToSelectedResult();

        return;
      }

      if (event.key === "Escape") {
        closeSearch();
        closeMobileSidebar();
      }
    });

    window.addEventListener("resize", () => {
      document.body.style.overflow = "";

      if (overlay) {
        overlay.classList.add("pointer-events-none", "opacity-0");

        overlay.classList.remove("pointer-events-auto", "opacity-100");
      }

      applySidebarState();
    });
  })();
</script>
