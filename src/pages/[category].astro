---
import { getCollection } from "astro:content";

import PostListItem from "@/components/content/PostListItem.astro";

import { categoryEntries, getCategoryConfig } from "@/config/categories";

import type { CategoryKey } from "@/config/categories";

import AppLayout from "@/layouts/AppLayout.astro";

export async function getStaticPaths() {
  return categoryEntries.map(([category]) => ({
    params: {
      category,
    },
    props: {
      category,
    },
  }));
}

interface Props {
  category: CategoryKey;
}

const { category } = Astro.props;

const categoryConfig = getCategoryConfig(category);

const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && data.category === category,
);

const sortedPosts = posts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const { label, description } = categoryConfig;
---

<AppLayout title={label} description={description}>
  <main class="min-h-[calc(100vh-4rem)]">
    <div
      class="mx-auto w-full max-w-[980px] px-5 py-8 sm:px-8 sm:py-10 lg:px-12 lg:py-12"
    >
      <header class="border-b border-border pb-8">
        <p class="text-[13px] font-medium text-accent">Biblioteca</p>

        <h1
          class="mt-3 text-[32px] font-semibold leading-[1.1] tracking-[-0.04em] text-foreground sm:text-[38px] lg:text-[42px]"
        >
          {label}
        </h1>

        <p class="mt-4 max-w-[680px] text-[15px] leading-7 text-muted">
          {description}
        </p>

        <p class="mt-5 text-[12px] text-border-muted">
          {
            sortedPosts.length === 1
              ? "1 artículo"
              : `${sortedPosts.length} artículos`
          }
        </p>
      </header>

      <section>
        {
          sortedPosts.length > 0 ? (
            sortedPosts.map((post, index) => (
              <PostListItem post={post} isFirstInList={index === 0} />
            ))
          ) : (
            <div class="rounded-lg border border-border bg-[#050505] px-6 py-10">
              <p class="text-[15px] font-medium text-foreground">
                Todavía no hay contenido.
              </p>

              <p class="mt-2 text-[14px] leading-6 text-subtle">
                Cuando añadas un Markdown dentro de esta categoría aparecerá
                aquí automáticamente.
              </p>
            </div>
          )
        }
      </section>
    </div>
  </main>
</AppLayout>
