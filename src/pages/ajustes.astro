---
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout title="Ajustes">
  <main class="min-h-[calc(100vh-4rem)]">
    <div class="mx-auto w-full max-w-[820px] px-6 py-12 sm:px-8 lg:px-12">
      <header class="border-b border-[#262626] pb-8">
        <p class="text-[13px] font-medium text-[#3291ff]">Aprendo</p>

        <h1
          class="mt-3 text-[36px] font-semibold tracking-[-0.04em] text-[#ededed] sm:text-[42px]"
        >
          Ajustes
        </h1>

        <p class="mt-4 max-w-[640px] text-[15px] leading-7 text-[#a1a1a1]">
          Preferencias generales de tu biblioteca personal.
        </p>
      </header>

      <section class="divide-y divide-[#262626]">
        <div class="flex items-center justify-between gap-6 py-6">
          <div>
            <h2 class="text-[14px] font-medium text-[#ededed]">Apariencia</h2>

            <p class="mt-1 text-[13px] leading-5 text-[#737373]">
              Aprendo utiliza una única apariencia oscura.
            </p>
          </div>

          <span
            class="rounded-md border border-[#262626] bg-[#0a0a0a] px-3 py-1.5 text-[12px] text-[#a1a1a1]"
          >
            Oscuro
          </span>
        </div>

        <div class="flex items-center justify-between gap-6 py-6">
          <div>
            <h2 class="text-[14px] font-medium text-[#ededed]">Contenido</h2>

            <p class="mt-1 text-[13px] leading-5 text-[#737373]">
              Los artículos se administran mediante Markdown.
            </p>
          </div>

          <span class="text-[12px] text-[#737373]"> Content Collections </span>
        </div>
      </section>
    </div>
  </main>
</AppLayout>
