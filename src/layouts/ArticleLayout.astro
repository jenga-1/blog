---
import { CalendarDays, Clock3 } from "@lucide/astro";

import ArticleStructuredData from "@/components/content/ArticleStructuredData.astro";
import ArticleEnhancements from "@/components/content/ArticleEnhancements.astro";
import FavoriteButton from "@/components/content/FavoriteButton.astro";
import MobileTableOfContents from "@/components/content/MobileTableOfContents.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";

import AppLayout from "@/layouts/AppLayout.astro";

import { formatDate } from "@/utils/format-date";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  postId: string;
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  readingTime: number;
  headings: Heading[];
  slug: string;
  image?: string;
}

const {
  postId,
  title,
  description,
  publishedAt,
  updatedAt,
  tags,
  readingTime,
  headings,
  slug,
  image,
} = Astro.props;

const lastUpdated = updatedAt ?? publishedAt;
---

<AppLayout
  title={title}
  description={description}
  image={image}
  canonical={`/${slug}`}
  ogType="article"
>
  <ArticleStructuredData
    slot="head"
    title={title}
    description={description}
    slug={slug}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    image={image}
    tags={tags}
  />
  <main class="min-h-[calc(100vh-4rem)]">
    <div
      class="mx-auto grid w-full max-w-[1180px] grid-cols-1 gap-12 px-5 py-8 sm:px-8 sm:py-10 lg:px-10 lg:py-12 xl:grid-cols-[minmax(0,760px)_240px] xl:gap-16 xl:px-12"
    >
      <article class="min-w-0 pb-20 sm:pb-24">
        <header class="border-b border-[#262626] pb-7 sm:pb-8">
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="min-w-0 flex-1">
              <h1
                class="max-w-[760px] text-[32px] font-semibold leading-[1.08] tracking-[-0.04em] text-[#ededed] sm:text-[40px] lg:text-[48px]"
              >
                {title}
              </h1>

              <p
                class="mt-4 max-w-[700px] text-[15px] leading-7 text-[#a1a1a1] sm:mt-5 sm:text-[16px]"
              >
                {description}
              </p>
            </div>

            <FavoriteButton postId={postId} />
          </div>

          <div
            class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 sm:mt-7 sm:gap-x-6"
          >
            <div
              class="flex items-center gap-2 text-[12px] text-[#a1a1a1] sm:text-[13px]"
            >
              <CalendarDays class="size-4" stroke-width={1.75} />

              <time datetime={publishedAt.toISOString()}>
                {formatDate(publishedAt)}
              </time>
            </div>

            <div
              class="flex items-center gap-2 text-[12px] text-[#a1a1a1] sm:text-[13px]"
            >
              <Clock3 class="size-4" stroke-width={1.75} />

              <span>
                {readingTime} min de lectura
              </span>
            </div>

            {
              tags.length > 0 && (
                <div class="flex w-full flex-wrap gap-2 sm:w-auto">
                  {tags.map((tag) => (
                    <span class="rounded-full border border-[#262626] bg-[#111111] px-2.5 py-1 text-[11px] leading-none text-[#a1a1a1] sm:text-[12px]">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
          </div>
        </header>

        <div class="mt-6 xl:hidden">
          <MobileTableOfContents headings={headings} />
        </div>

        <div class="article-content pt-7 sm:pt-8">
          <slot />
        </div>
      </article>

      <aside class="hidden xl:block">
        <TableOfContents headings={headings} lastUpdated={lastUpdated} />
      </aside>
    </div>
  </main>

  <ArticleEnhancements />
</AppLayout>
